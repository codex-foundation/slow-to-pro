---
import Icon from './Icon.astro';
import { pricing } from '@/content/pricing';
---

<section id="pricing" class="mx-auto max-w-[1200px] px-5 py-24 sm:px-8 md:py-32">
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-primary)]">
      Pricing
    </p>
    <h2 class="mt-3 text-balance text-4xl font-semibold tracking-tight md:text-5xl">
      Free to start.<br /><span class="text-[var(--color-text-subtle)]">Fair to grow with.</span>
    </h2>
  </div>

  <div class="mt-16 grid gap-6 md:grid-cols-2">
    {
      pricing.map((tier) => (
        <div
          class={`relative flex flex-col rounded-3xl border p-8 transition ${
            tier.highlight
              ? 'border-[var(--color-primary)] bg-[var(--color-surface)] shadow-[0_30px_80px_-20px_rgba(37,99,235,0.35)]'
              : 'border-[var(--color-border)] bg-[var(--color-surface)]'
          }`}
        >
          {tier.highlight && (
            <span class="absolute -top-3 left-8 rounded-full bg-[var(--color-primary)] px-3 py-1 text-[11px] font-medium uppercase tracking-[0.14em] text-white">
              Most loved
            </span>
          )}

          <div class="flex items-baseline gap-3">
            <h3 class="text-2xl font-semibold tracking-tight">{tier.name}</h3>
            <span class="text-sm text-[var(--color-text-subtle)]">{tier.tagline}</span>
          </div>

          <div class="mt-6 flex items-baseline gap-2">
            <span class="text-5xl font-semibold tracking-tight">
              {tier.monthly === 0 ? '€0' : `€${tier.monthly}`}
            </span>
            <span class="text-[var(--color-text-subtle)]">/ month</span>
          </div>
          {tier.yearly > 0 && (
            <p class="mt-1 text-sm text-[var(--color-text-subtle)]">
              or €{tier.yearly}/year — save {Math.round(100 - (tier.yearly / (tier.monthly * 12)) * 100)}%
            </p>
          )}

          <ul class="mt-8 flex-1 space-y-3">
            {tier.features.map((f) => (
              <li class="flex items-center gap-3 text-[15px] text-[var(--color-text-muted)]">
                <span
                  class={`inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full ${
                    tier.highlight
                      ? 'bg-[var(--color-primary)] text-white'
                      : 'bg-[var(--color-primary-soft)] text-[var(--color-primary)]'
                  }`}
                >
                  <Icon name="check" size={14} />
                </span>
                {f}
              </li>
            ))}
          </ul>

          <a
            href="#download"
            class={`mt-10 inline-flex items-center justify-center rounded-2xl px-5 py-3 font-medium transition hover:-translate-y-0.5 ${
              tier.highlight
                ? 'bg-[var(--color-primary)] text-white hover:opacity-95'
                : 'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-primary)]/40'
            }`}
          >
            {tier.cta}
          </a>
        </div>
      ))
    }
  </div>
</section>
