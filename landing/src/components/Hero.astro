---
import StoreBadges from './StoreBadges.astro';
import PhoneMockup from './PhoneMockup.astro';
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden">
  <!-- Halo backdrop -->
  <div class="pointer-events-none absolute inset-0 -z-10 halo"></div>

  <div class="mx-auto grid max-w-[1200px] items-center gap-14 px-5 pt-20 pb-20 sm:px-8 md:pt-28 md:pb-28 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/60 px-3 py-1 text-xs text-[var(--color-text-muted)] backdrop-blur"
      >
        <Icon name="sparkles" size={14} class="text-[var(--color-primary)]" />
        New · Built for focus, not for noise
      </div>

      <h1
        class="text-balance text-5xl font-semibold leading-[1.05] tracking-[-0.035em] sm:text-6xl md:text-7xl lg:text-[80px]"
      >
        Go from <span class="italic text-[var(--color-primary)]">slow</span> to pro,<br class="hidden sm:block" />
        one focused day at a time.
      </h1>

      <p
        class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-[var(--color-text-muted)] md:text-xl"
      >
        Tasks, Pomodoro, and finances in a single calm app. Private by default.
        iOS, Android, and the web — one account, everywhere you go.
      </p>

      <div class="mt-10" id="download">
        <StoreBadges />
        <p class="mt-4 text-sm text-[var(--color-text-subtle)]">
          Free forever · No account required · Works offline
        </p>
      </div>
    </div>

    <div class="relative">
      <PhoneMockup class="reveal" />
    </div>
  </div>

  <!-- Social proof strip -->
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6 border-y border-[var(--color-border)] px-5 py-6 text-sm text-[var(--color-text-subtle)] sm:px-8"
  >
    <span class="font-medium text-[var(--color-text)]">★★★★★ 4.8 · App Store</span>
    <span>Featured in “Stay Focused” collection</span>
    <span>12,000+ focused minutes logged every day</span>
    <span class="hidden sm:inline">Loved by students, founders, and quiet doers</span>
  </div>
</section>
