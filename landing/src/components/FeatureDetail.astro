---
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';
import type { Feature } from '@/content/features';

interface Props {
  feature: Feature;
  reverse?: boolean;
}
const { feature, reverse = false } = Astro.props;
---

<section
  id={feature.id}
  class="relative mx-auto max-w-[1200px] px-5 py-20 sm:px-8 md:py-28"
>
  <div
    class={`grid items-center gap-14 lg:grid-cols-2 ${reverse ? 'lg:[&>*:first-child]:order-2' : ''}`}
  >
    <div class="reveal">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-primary)]">
        {feature.eyebrow}
      </p>
      <h3 class="mt-3 text-balance text-3xl font-semibold tracking-tight md:text-5xl">
        {feature.title}
      </h3>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-[var(--color-text-muted)]">
        {feature.detail}
      </p>

      <ul class="mt-8 space-y-3">
        {feature.bullets.map((bullet) => (
          <li class="flex items-center gap-3 text-[15px] text-[var(--color-text-muted)]">
            <span
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[var(--color-primary)]"
            >
              <Icon name="check" size={14} />
            </span>
            {bullet}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative flex items-center justify-center">
      <div class="pointer-events-none absolute inset-0 halo"></div>
      <PhoneMockup screenshot={feature.screenshot} alt={`${feature.shortTitle} screen`} class="reveal" />
    </div>
  </div>
</section>
