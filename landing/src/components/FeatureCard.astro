---
import Icon from './Icon.astro';
import type { Feature } from '@/content/features';

interface Props {
  feature: Feature;
}
const { feature } = Astro.props;
---

<a
  href={`#${feature.id}`}
  class="group relative flex flex-col gap-4 overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 transition duration-300 hover:-translate-y-1 hover:border-[var(--color-primary)]/40 hover:shadow-[0_30px_60px_-30px_rgba(37,99,235,0.4)]"
>
  <div
    class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--color-primary-soft)] text-[var(--color-primary)]"
  >
    <Icon name={feature.icon} size={22} />
  </div>

  <div class="flex-1">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-[var(--color-text-subtle)]">
      {feature.eyebrow}
    </p>
    <h3 class="mt-2 text-xl font-semibold tracking-tight">{feature.title}</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-text-muted)]">{feature.copy}</p>
  </div>

  <div class="flex items-center gap-1 text-sm text-[var(--color-primary)]">
    Learn more
    <Icon
      name="arrow-right"
      size={16}
      class="transition-transform duration-300 group-hover:translate-x-1"
    />
  </div>
</a>
