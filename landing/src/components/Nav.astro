---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-border)]/60 bg-[color:color-mix(in_oklab,var(--color-bg)_78%,transparent)] backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <Logo size={30} class="rounded-lg" />
      <span class="text-[15px]">Slow to Pro</span>
    </a>

    <nav class="hidden items-center gap-8 text-sm text-[var(--color-text-muted)] md:flex">
      <a href="#features" class="transition hover:text-[var(--color-text)]">Features</a>
      <a href="#philosophy" class="transition hover:text-[var(--color-text)]">Philosophy</a>
      <a href="#pricing" class="transition hover:text-[var(--color-text)]">Pricing</a>
      <a href="#faq" class="transition hover:text-[var(--color-text)]">FAQ</a>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="#download"
        class="hidden rounded-full bg-[var(--color-text)] px-4 py-2 text-sm font-medium text-[var(--color-bg)] transition hover:opacity-90 sm:inline-flex"
      >
        Download
      </a>
    </div>
  </div>
</header>
