---
import Logo from './Logo.astro';
---

<footer class="border-t border-[var(--color-border)]">
  <div
    class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-8 px-5 py-12 sm:px-8 md:flex-row md:items-center"
  >
    <div class="flex items-center gap-3">
      <Logo size={28} class="rounded-lg" />
      <div class="leading-tight">
        <p class="font-semibold tracking-tight">Slow to Pro</p>
        <p class="text-sm text-[var(--color-text-subtle)]">Focus, gently.</p>
      </div>
    </div>

    <nav class="flex flex-wrap items-center gap-6 text-sm text-[var(--color-text-muted)]">
      <a href="#features" class="transition hover:text-[var(--color-text)]">Features</a>
      <a href="#pricing" class="transition hover:text-[var(--color-text)]">Pricing</a>
      <a href="#faq" class="transition hover:text-[var(--color-text)]">FAQ</a>
      <a href="mailto:hello@slowtopro.app" class="transition hover:text-[var(--color-text)]">Contact</a>
      <a href="/privacy" class="transition hover:text-[var(--color-text)]">Privacy</a>
      <a href="/terms" class="transition hover:text-[var(--color-text)]">Terms</a>
    </nav>
  </div>
  <div
    class="mx-auto max-w-[1200px] border-t border-[var(--color-border)] px-5 py-6 text-sm text-[var(--color-text-subtle)] sm:px-8"
  >
    © {new Date().getFullYear()} Slow to Pro. Made calmly.
  </div>
</footer>
