---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  class={className}
  aria-label="Slow to Pro logo"
>
  <rect width="1024" height="1024" rx="220" fill="var(--color-primary)"></rect>
  <circle cx="512" cy="530" r="274" fill="none" stroke="white" stroke-width="42"></circle>
  <line x1="438" y1="228" x2="586" y2="228" stroke="white" stroke-width="38" stroke-linecap="round"></line>
  <line x1="512" y1="180" x2="512" y2="256" stroke="white" stroke-width="38" stroke-linecap="round"></line>
  <line x1="786" y1="530" x2="742" y2="530" stroke="white" stroke-width="30" stroke-linecap="round" opacity="0.45"></line>
  <line x1="238" y1="530" x2="282" y2="530" stroke="white" stroke-width="30" stroke-linecap="round" opacity="0.45"></line>
  <line x1="386" y1="660" x2="638" y2="380" stroke="white" stroke-width="46" stroke-linecap="round"></line>
  <polyline points="602,420 638,380 596,368" fill="none" stroke="white" stroke-width="42" stroke-linecap="round" stroke-linejoin="round"></polyline>
  <circle cx="386" cy="660" r="26" fill="white"></circle>
</svg>
